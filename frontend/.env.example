# Frontend environment variables (Vite only exposes vars prefixed VITE_ to the browser bundle)
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# SAFE FOR FRONTEND — these are meant to be public/client-side values.
# Do NOT put SUPABASE_SECRET_KEY, AI_API_KEY, or EMAIL_APP_PASSWORD here or
# anywhere else in frontend code — those are backend-only secrets.

# Supabase project URL (matches root SUPABASE_URL)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (matches root SUPABASE_PUBLISHABLE_KEY) — safe for client-side use
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Base URL of the backend API (NOT yet defined in the root .env.example — flagged for the team)
VITE_API_BASE_URL=http://localhost:8000
